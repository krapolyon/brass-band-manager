# macOS
.DS_Store

# Dependencies and build output
node_modules/
vendor/
dist/

# What the host receives, assembled by scripts/assemble-release.mjs
/build/

# Local configuration and secrets: never committed
.env
.env.*
!.env.example

# Music files: never committed, even in tests
*.mscz
*.mp3
*.mid
*.midi
*.musicxml
*.mxl

# Test output
test-results/
playwright-report/

# Logs
*.log

# Personal Claude Code settings
.claude/settings.local.json

# Server configuration: holds the database password on the host
api/config.php
# The encryption key of the local stack (npm run setup)
api/encryptionKey.local

# Files uploaded by members (logo, later songs): never committed
/storage/
