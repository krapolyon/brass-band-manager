# The only folder of the deployed tree a browser reaches: the built front,
# and the relay of the API in api/. Written before the rules of
# web/public/.htaccess by scripts/assemble-release.mjs.
Require all granted

RewriteEngine On

# The host serves this folder as the root of the app. Reached under /web/, it
# is being read through a site that serves the whole deployed folder, which
# exists for the host's own needs (the Git deployment of OVH): refused.
RewriteCond %{REQUEST_URI} ^/+web/
RewriteRule ^ - [F]

# Everything goes over HTTPS. A host says in more than one way that a request
# arrived encrypted, depending on what stands in front of Apache: the request
# is sent to HTTPS only when none of them says so.
RewriteCond %{HTTPS} !=on
RewriteCond %{ENV:HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteCond %{SERVER_PORT} !=443
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Below: web/public/.htaccess, as on the local stack.
# The front is a single page: any address that is not a real file
# is answered by index.html, and React shows the right screen.
RewriteEngine On

# Some browsers ask /favicon.ico whatever the page names (Safari and Chrome,
# for bookmarks and restored tabs). It is answered with the icon of the band,
# the one index.html names, never with index.html (issue #63). A redirect, not
# a rewrite: the API reads the address the browser asked for. 302: asked again
# each time, so that a new icon of the band is seen.
RewriteRule ^favicon\.ico$ /api/band/icon/192 [R=302,L]

RewriteCond %{REQUEST_URI} !^/api/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /index.html [L]

# The MuseScore engine is a module and a compiled program: said as such,
# or a browser refuses to run them (web/src/screens/songs/score.worker.ts).
AddType text/javascript .mjs
AddType application/wasm .wasm

# The typefaces of the app are also offered to the emails it sends (#65): a
# mail client reads them from another origin than the app.
<IfModule mod_headers.c>
  <FilesMatch "\.woff2$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>
