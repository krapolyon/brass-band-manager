# The front is a single page: any address that is not a real file
# is answered by index.html, and React shows the right screen.
RewriteEngine On

# Some browsers ask /favicon.ico whatever the page names (Safari and Chrome,
# for bookmarks and restored tabs). It is answered with the icon of the band,
# the one index.html names, never with index.html (issue #63). A redirect, not
# a rewrite: the API reads the address the browser asked for. 302: asked again
# each time, so that a new icon of the band is seen.
RewriteRule ^favicon\.ico$ /api/band/icon/192 [R=302,L]

RewriteCond %{REQUEST_URI} !^/api/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /index.html [L]

# The MuseScore engine is a module and a compiled program: said as such,
# or a browser refuses to run them (web/src/screens/songs/score.worker.ts).
AddType text/javascript .mjs
AddType application/wasm .wasm

# Security headers of the front (issue #51). Not on /api, whose answers PHP
# writes with their own headers (api/public/index.php, ServeFile): an address
# answered twice would carry two values.
#   - Content-Security-Policy: what a page of the app may load and run. Scripts
#     come from the app only, never written in the page; 'wasm-unsafe-eval'
#     lets the MuseScore and Verovio engines run, blob: lets the map start its
#     workers. Connections and images may go to any https address: the server
#     of the map tiles is a setting of each instance (mapTilesUrl); and to
#     blob: and data:, how the app reads a file the member chose (a logo). Styles may
#     be written in the page, as the map and the score engines do. The only
#     frame is the YouTube player. No page may show the app in a frame.
#   - X-Frame-Options says the same last point to older browsers.
#   - The one exception is the worker that reads MuseScore files
#     (score.worker.ts): the MuseScore engine writes functions at start
#     ('unsafe-eval'). A worker follows the policy sent with its own script,
#     so this one gets it, and the pages do not: it has no access to them and
#     only receives a file and sends back what it read.
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} !~ m#^/api/#">
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "DENY"
  </If>
  <If "%{REQUEST_URI} =~ m#^/assets/score\.worker-#">
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; object-src 'none'; base-uri 'self'"
  </If>
  <ElseIf "%{REQUEST_URI} !~ m#^/api/#">
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self'; connect-src 'self' https: blob: data:; media-src 'self' blob:; worker-src 'self' blob:; frame-src https://www.youtube-nocookie.com; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
  </ElseIf>
</IfModule>

# The typefaces of the app are also offered to the emails it sends (#65): a
# mail client reads them from another origin than the app.
<IfModule mod_headers.c>
  <FilesMatch "\.woff2$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>
